# Node runtime environment mode
NODE_ENV=production

# Server listening port
PORT=5000

# PostgreSQL Connection String URI (Render or local Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT Token signature secret
JWT_SECRET=your-jsonwebtoken-cryptographic-hash-secret-here

# Trusted client URL for CORS authorization
CLIENT_URL=https://your-vercel-frontend-domain.vercel.app
